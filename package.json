{
  "name": "lanes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:web": "vitest run apps/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "tsx apps/sim/src/run.ts",
    "build": "node apps/web/build.mjs",
    "build:site": "node apps/web/build.mjs --site"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "preact": "^10.26.4"
  }
}
